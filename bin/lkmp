#!/usr/bin/env python3
"""Executable wrapper for the `lkmp` CLI."""

from pathlib import Path
import sys

# Ensure repository root is on sys.path when invoked directly via ./bin/lkmp
repo_root = Path(__file__).resolve().parent.parent
if str(repo_root) not in sys.path:
    sys.path.insert(0, str(repo_root))

from lkmp.cli import main

if __name__ == "__main__":
    sys.exit(main())
