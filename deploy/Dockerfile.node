FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/lkmp
COPY . /opt/lkmp

RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 \
    iputils-arping \
    nftables \
    rsync \
    openssh-client \
    openssh-server \
    python3 \
    stress-ng \
    && (apt-get install -y --no-install-recommends criu || bash /opt/lkmp/scripts/install_criu_on_linux.sh) \
    && rm -rf /var/lib/apt/lists/* \
    && chmod +x /opt/lkmp/bin/lkmp && ln -sf /opt/lkmp/bin/lkmp /usr/local/bin/lkmp

EXPOSE 9440 27000 27001

CMD ["lkmp", "agent", "--host", "0.0.0.0", "--port", "9440", "--work-dir", "/var/lib/lkmp", "--tls-ca", "/etc/lkmp/tls/ca.crt", "--tls-cert", "/etc/lkmp/tls/node.crt", "--tls-key", "/etc/lkmp/tls/node.key"]
