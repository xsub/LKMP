FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    criu \
    iproute2 \
    iputils-arping \
    nftables \
    rsync \
    openssh-client \
    openssh-server \
    python3 \
    stress-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/lkmp
COPY . /opt/lkmp
RUN chmod +x /opt/lkmp/bin/lkmp && ln -s /opt/lkmp/bin/lkmp /usr/local/bin/lkmp

EXPOSE 9700 27000 27001

CMD ["lkmp", "agent", "--host", "0.0.0.0", "--port", "9700", "--no-tls"]
